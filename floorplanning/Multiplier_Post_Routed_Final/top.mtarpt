VERSION {1.0}
PTDEF {instance} {pin} {cell} {edge} {clock_edge} {clock} {phase}
BANNER
  {Module} {mul32_pipeline}
  {Timing} {EARLY}
  {Slew Propagation} {WORST}
  {Operating Condition} {fast}
  {PVT Mode} {min}
  {Tree Type} {worst_case}
  {Process} {1.000}
  {Voltage} {1.100}
  {Temperature} {0.000}
  {time unit} {1.000 ns}
  {capacitance unit} {1.000 pF}
  {resistance unit} {1.000 kOhm}
  {TOOL} {v20.20-p001_1 ((64bit) 12/02/2020 16:07 (Linux 2.6.32-431.11.2.el6.x86_64))}
  {DATE} {June 06, 2026}
END_BANNER
PATH 1
  VIEW  best_case
  CHECK_TYPE {Removal Check}
  REF {psum_lo_s2_reg[3]} {CK}
  ENDPT {psum_lo_s2_reg[3]} {RN} {DFFRHQX1} {^} {leading} {clk} {clk(C)(P)(best_case)*}
  BEGINPT {} {rst_n} {} {^} {leading} {@} {@(D)(P)(best_case)*}
  REQ_CLC
    {} {Other End Arrival Time} {0.000}
    {+} {Removal} {0.102}
    {+} {Phase Shift} {0.000}
    {+} {Uncertainty} {0.010}
    {=} {Required Time} {0.112}
  END_REQ_CLC
  SLK_CLC
    {} {Arrival Time} {0.004}
    {} {Slack Time} {-0.108}
  END_SLK_CLC
  SLK -0.108
  ARR_CLC
    {} {Clock Rise Edge} {0.000}
    {+} {Input Delay} {0.000}
    {=} {Beginpoint Arrival Time} {0.000}
  END_ARR_CLC
  LAUNCH_CLK_PATH
    COLUMNS {instance} {fpin} {fedge} {tpin} {tedge} {net} {cell} {delay} {incr_delay} {slew} {load} {arrival} {required} {stolen} {fanout} {pin_location}
  END_LAUNCH_CLK_PATH 
  DATA_PATH 
    COLUMNS {instance} {fpin} {fedge} {tpin} {tedge} {net} {cell} {delay} {incr_delay} {slew} {load} {arrival} {required} {stolen} {fanout} {pin_location} 
    PORT {} {rst_n} {^} {} {} {rst_n} {} {} {} {0.003} {0.281} {0.000} {0.108} {} {59} {(0.00, 107.16) } 
    NET {} {} {} {} {} {rst_n} {} {0.004} {0.000} {0.012} {0.281} {0.004} {0.112} {} {} {} 
  END_DATA_PATH
  OTHER_ARR_CLC
    {} {Clock Rise Edge} {0.000}
    {=} {Beginpoint Arrival Time} {0.000}
  END_OTHER_ARR_CLC
  CAP_CLK_PATH
    COLUMNS {instance} {fpin} {fedge} {tpin} {tedge} {net} {cell} {delay} {incr_delay} {slew} {load} {arrival} {required} {stolen} {fanout} {pin_location}
    PORT {} {clk} {^} {} {} {clk} {} {} {} {0.100} {0.800} {0.000} {-0.108} {} {324} {(0.00, 107.16) } 
    NET {} {} {} {} {} {clk} {} {0.000} {0.000} {0.100} {0.800} {0.000} {-0.108} {} {} {} 
  END_CAP_CLK_PATH
END_PATH 1
